
decl count = 1
while count <= 100 do
    if count % 15 == 0 do
        puts("Fizz Buzz")
    else if count % 5 == 0 do
        puts("Buzz")
    else if count % 3 == 0 do 
        puts("Fizz")
    else 
        libc_print_int(count)
        puts("") // newline
    
    count+=1

#include "easy.magic"
