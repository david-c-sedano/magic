
InitWindow(800, 450, "raylib [magic] example - basic window")
SetTargetFPS(60)

while !WindowShouldClose() do
    BeginDrawing()
    ClearBackground(0xf5f5f5ff)

    decl myrec = rectangle:(100.0, 100.0, 100.0, 100.0)
    DrawRectangleRec(myrec, 0xff0000ff)

    EndDrawing()

CloseWindow()

#include "raylib.magic"
