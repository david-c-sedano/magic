

decl result = factorial(5)
exit(result)

forward factorial = def(n)
    if n <= 1 do
        return 1
    else 
        return n * factorial(n - 1)

// annoying
layout _libcArgs_Exit align 8
    status: s32

forward exit = def(status) do
    decl args = push _libcArgs_Exit
    args.status = status
    invoke:exit args
