
decl result = fibonacci(10)
exit(result)

forward fibonacci = def(n)
    if n <= 1 do
        return n
    else
        return fibonacci(n - 1) + fibonacci(n - 2)

// annoying
layout _libcArgs_Exit align 8
    status: s32

forward exit = def(status) do
    decl args = push _libcArgs_Exit
    args.status = status
    invoke:exit args
